tryDy=0;" edge="1" parent="1" source="wk" target="fs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="480" /><mxPoint x="581.5" y="480" /></Array></mxGeometry></mxCell><mxCell id="e11" value="файл" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="gcs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1067" y="505" /><mxPoint x="952.5" y="505" /></Array></mxGeometry></mxCell><mxCell id="e12" value="метрики" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="ai" target="mon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Основные решения&lt;/b&gt;&lt;br&gt;• Cloud Armor фильтрует трафик и ограничивает частоту запросов до попадания в API.&lt;br&gt;• min 2 для API убирает холодные старты; Worker масштабируется по очереди, Cloud Tasks ограничивает скорость к модели.&lt;br&gt;• Бэкапы Firestore, алерты и бюджет; полный отказ региона — отдельный риск (не покрыт)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E3E8EF;align=left;verticalAlign=top;spacingLeft=22;spacingTop=8;fontSize=14;fontColor=#344054;" vertex="1" parent="1"><mxGeometry x="45" y="710" width="1340" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
