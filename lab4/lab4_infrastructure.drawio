<mxfile host="app.diagrams.net" type="device"><diagram id="stage1" name="01. Начальный MVP"><mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="860" as="geometry" /></mxCell><mxCell id="hdr" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#152C46;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="110" as="geometry" /></mxCell><mxCell id="ttl" value="Этап 1 · Начальный MVP" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1300" height="36" as="geometry" /></mxCell><mxCell id="sub" value="100 пользователей · 1 000 AI-генераций в месяц · один сервис Cloud Run" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#B9D6F3;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="26" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Браузер, ввод текста&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF3FF;strokeColor=#4F7EBF;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="200" height="88" as="geometry" /></mxCell><mxCell id="run" value="&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;UI + API · min 0 · max 3&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7EF;strokeColor=#28835A;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="200" height="88" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Gemini 3.5 Flash-Lite&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#7254BC;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="200" height="88" as="geometry" /></mxCell><mxCell id="fs" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;История, лимиты&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3E4;strokeColor=#C58A37;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="270" width="200" height="88" as="geometry" /></mxCell><mxCell id="gcs" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Экспорт конспектов&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3E4;strokeColor=#C58A37;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="390" width="200" height="88" as="geometry" /></mxCell><mxCell id="log" value="&lt;b&gt;Cloud Logging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Логи, ошибки, бюджет&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F6F6;strokeColor=#257A7F;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="510" width="200" height="88" as="geometry" /></mxCell><mxCell id="sa" value="&lt;b&gt;Service Account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;IAM, минимальные права&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF0F3;strokeColor=#A9516A;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="200" height="88" as="geometry" /></mxCell><mxCell id="e0" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="промпт → ответ" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="ai"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="344" /><mxPoint x="700" y="194" /></Array></mxGeometry></mxCell><mxCell id="e2" value="запись истории" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="fs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="344" /><mxPoint x="700" y="314" /></Array></mxGeometry></mxCell><mxCell id="e3" value="файл .md/.pdf" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="gcs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="344" /><mxPoint x="700" y="434" /></Array></mxGeometry></mxCell><mxCell id="e4" value="логи" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="344" /><mxPoint x="700" y="554" /></Array></mxGeometry></mxCell><mxCell id="e5" value="идентичность" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="sa" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Основные решения&lt;/b&gt;&lt;br&gt;• Один контейнер Cloud Run: быстро развернуть и обновлять, платим только за запросы.&lt;br&gt;• Нет постоянных VM и GPU: модель вызывается по API, масштабирование до нуля.&lt;br&gt;• max 3 экземпляра и бюджетное уведомление защищают от случайного перерасхода." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E3E8EF;align=left;verticalAlign=top;spacingLeft=22;spacingTop=8;fontSize=14;fontColor=#344054;" vertex="1" parent="1"><mxGeometry x="45" y="710" width="1340" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="stage2" name="02. Тестирование партнёрами"><mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="860" as="geometry" /></mxCell><mxCell id="hdr" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#152C46;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="110" as="geometry" /></mxCell><mxCell id="ttl" value="Этап 2 · Тестирование партнёрами" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1300" height="36" as="geometry" /></mxCell><mxCell id="sub" value="2 000 пользователей · 40 000 AI-генераций в месяц · фоновые задания" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#B9D6F3;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="26" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;Партнёры&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Веб-приложение&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF3FF;strokeColor=#4F7EBF;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="200" height="88" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;Cloud Run API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Приём заданий · min 0&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7EF;strokeColor=#28835A;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="200" height="88" as="geometry" /></mxCell><mxCell id="q" value="&lt;b&gt;Cloud Tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Очередь, повторы&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF1FF;strokeColor=#5B6DB8;strokeWidth=2;fontSize=16;fontColor=#18314F;align=c