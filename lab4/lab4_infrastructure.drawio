t; color=&quot;#516278&quot;&gt;Результаты (приватно)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3E4;strokeColor=#C58A37;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="450" width="200" height="88" as="geometry" /></mxCell><mxCell id="mon" value="&lt;b&gt;Logging + Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#516278&quot;&gt;Логи, алерты, бюджет&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F6F6;strokeColor=#257A7F;strokeWidth=2;fontSize=16;fontColor=#18314F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1140" y="450" width="200" height="88" as="geometry" /></mxCell><mxCell id="e0" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="user" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="задание" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="api" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="доставка" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="q" target="wk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="LLM" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="wk" target="ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="вход" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="user" target="idp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="статус «в очереди»" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.325;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="fs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="370" /><mxPoint x="530" y="370" /></Array></mxGeometry></mxCell><mxCell id="e6" value="статус «готово»" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.825;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="fs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="370" /><mxPoint x="630" y="370" /></Array></mxGeometry></mxCell><mxCell id="e7" value="результат" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="gcs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="токены, ошибки" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B889A;strokeWidth=2;fontSize=12;fontColor=#344054;labelBackgroundColor=#F7F9FC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="ai" target="mon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Основные решения&lt;/b&gt;&lt;br&gt;• API сразу возвращает ID задания; клиент опрашивает статус в Firestore.&lt;br&gt;• Cloud Tasks сглаживает пики и повторяет ошибки; повтор не обрабатывает задание дважды (проверка статуса).&lt;br&gt;• Сервисы по-прежнему масштабируются до нуля; дневные квоты генераций на партнёра." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E3E8EF;align=left;verticalAlign=top;spacingLeft=22;spacingTop=8;fontSize=14;fontColor=#344054;" vertex="1" parent="1"><mxGeometry x="45" y="710" width="1340" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="stage3" name="03. Продакшн"><mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="860" as="geometry" /></mxCell><mxCell id="hdr" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#152C46;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1430" height="110" as="geometry" /></mxCell><mxCell id="ttl" value="Этап 3 · Продакшн" style="text;html=1;align=left;verti